# Laptop-only. Copy to supabase/.env.dev and supabase/.env.prod (gitignored).
# Used by standup / deploy:aws to run `.lattice/standup.json` SQL via psql.
# Not used by the API or web runtime (those stay in apps/api/.env and Infisical /shared).

# Project Settings → Database → URI.
# Session pooler on port 5432 is fine. Do not use the transaction pooler (6543).
# Password may contain @ or ! — standup uses the last @ as the host.
# Host region comes from the dashboard Connect dialog (not this example).
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
